# WordPress headless SDK credentials.
# Copy this file to .env.local and fill in real values. .env.local is
# already gitignored by Next.js — never commit credentials.

# Full URL of your WordPress install (no trailing slash).
WP_URL=https://your-wp-site.com

# Same value as WP_URL, but exposed to the client bundle. Used to rewrite
# WP media URLs (which WP serializes with home_url(), i.e. the public-site
# hostname) so they resolve to the actual WP origin. Required post-cutover
# when this Next app *is* the public site and would otherwise self-reference.
NEXT_PUBLIC_WP_URL=https://your-wp-site.com

# WordPress username with at least 'read' capability.
WP_USER=admin

# Application Password generated at WP Admin → Users → your profile →
# Application Passwords. Spaces in the value are fine; do not quote.
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Optional: incremental-migration proxy URL.
#
# When set, any route NOT handled by this Next.js app falls through to
# this URL automatically (the "strangler fig" pattern). Useful for
# migrating an existing site to headless one route at a time — your new
# /posts implementation renders normally while /about still proxies to
# the original WP site until you build it locally.
#
# Leave empty to disable proxying. Unmatched routes will 404 instead.
WP_PROXY_URL=

# Dev-only: disable TLS verification when WP_URL or WP_PROXY_URL points
# to a local-dev host (LocalWP, Valet, DDEV) with a self-signed cert.
# Both the SDK and Next.js's rewrite proxy use Node fetch, which refuses
# self-signed certs by default. NEVER set this in production — anything
# you fetch from outside your local machine becomes vulnerable to MITM.
# NODE_TLS_REJECT_UNAUTHORIZED=0

# Webhook revalidation secret (server-only). Generate with:
#   [Convert]::ToHexString([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(16))
REVALIDATE_SECRET=replace-with-32-char-random-hex

# Public site URL (used for canonical URLs, OG metadata, sitemap).
NEXT_PUBLIC_SITE_URL=https://hagopianink.com

# Base URL for WordPress-hosted media (hero videos, posters). Set this to the
# WordPress hostname — NOT the public site hostname — so that after cutover
# the front-end doesn't self-reference. Pre-cutover: https://hagopianink.com.
# Post-cutover: https://cms.hagopianink.com (or whatever subdomain you use).
NEXT_PUBLIC_WP_MEDIA_BASE_URL=https://hagopianink.com

# Resend API key — contact form submissions. Create at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional override — where contact-form submissions are sent.
# Defaults to info@HagopianInk.com.
CONTACT_TO_EMAIL=info@HagopianInk.com

# Optional override — the From address on contact emails. Defaults to
# Resend's onboarding sender. Replace once you verify hagopianink.com
# at https://resend.com/domains (recommended: contact@hagopianink.com).
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Google Analytics 4 measurement ID. Falls back to the production property
# (G-ENF9YZ2FTT) when unset, so previews still report — override locally to
# point at a debug stream, or unset to silence dev traffic.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-ENF9YZ2FTT

# Cloudflare edge cache purge (optional). When both are set, /api/revalidate
# purges the affected URL(s) at the CF edge after invalidating Next's data
# cache, so editors see WP changes within seconds instead of waiting for the
# edge TTL. Token needs only Zone.Cache Purge permission on the hagopianink
# zone. If unset, Next data cache still invalidates correctly — edge stays
# stale up to its TTL.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
