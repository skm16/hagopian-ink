# Build context exclusions for Dockerfile builds.
# Even though the Dockerfile only COPYs specific dirs, .dockerignore
# keeps the build context small (faster uploads to Railway's builder).

# Build artifacts
.next
node_modules
out

# Legacy / reference (never deployed)
artifacts
wordpress
attached_assets

# Local dev / OS / IDE
.git
.github
.vscode
.idea
.cursor
.replit
.replitignore
replit.md
.cache
.local
.expo
.expo-shared
.playwright-mcp
.sass-cache
.DS_Store
Thumbs.db

# Env files (Railway injects real env vars)
.env
.env.local
.env.*.local

# Scratch
.jab
screenshots

# Docs
docs

# Editor scratch
*.tsbuildinfo
